{
  "mcpServers": {
    "national-assembly": {
      "type": "stdio",
      "description": "대한민국 국회 MCP입니다. 열린국회정보 OpenAPI와 국민참여입법센터 API를 함께 조회합니다.",
      "command": "python",
      "args": [
        "extensions/mcp/national_assembly_bootstrap.py"
      ],
      "env": {
        "MCP_PROFILE": "full",
        "MCP_TRANSPORT": "stdio"
      },
      "tools": [
        { "name": "assembly_member", "description": "국회의원 검색과 활동 분석", "input_schema": { "type": "object", "additionalProperties": true } },
        { "name": "assembly_bill", "description": "의안 검색과 처리 경과 조회", "input_schema": { "type": "object", "additionalProperties": true } },
        { "name": "assembly_session", "description": "국회 일정과 회의록 조회", "input_schema": { "type": "object", "additionalProperties": true } },
        { "name": "assembly_org", "description": "위원회, 청원과 입법예고 조회", "input_schema": { "type": "object", "additionalProperties": true } },
        { "name": "discover_apis", "description": "열린국회정보 API 탐색", "input_schema": { "type": "object", "additionalProperties": true } },
        { "name": "query_assembly", "description": "열린국회정보 API 직접 조회", "input_schema": { "type": "object", "additionalProperties": true } },
        { "name": "bill_detail", "description": "의안 상세와 심사 이력 조회", "input_schema": { "type": "object", "additionalProperties": true } },
        { "name": "committee_detail", "description": "위원회 상세와 위원 명단 조회", "input_schema": { "type": "object", "additionalProperties": true } },
        { "name": "petition_detail", "description": "청원 상세 조회", "input_schema": { "type": "object", "additionalProperties": true } },
        { "name": "research_data", "description": "국회 연구자료 통합 조회", "input_schema": { "type": "object", "additionalProperties": true } },
        { "name": "get_nabo", "description": "국회예산정책처 자료 조회", "input_schema": { "type": "object", "additionalProperties": true } }
      ],
      "cwd": "."
    }
  }
}
