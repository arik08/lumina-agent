{
  "mcpServers": {
    "national-assembly": {
      "type": "stdio",
      "description": "대한민국 국회 MCP입니다. 열린국회정보 OpenAPI와 국민참여입법센터 API를 함께 조회합니다.",
      "command": "python",
      "args": [
        "runtime/bootstrap.py"
      ],
      "env": {
        "MCP_PROFILE": "full",
        "MCP_TRANSPORT": "stdio"
      },
      "tools": [
        {
          "name": "assembly_member",
          "description": "국회의원을 검색하고 의정활동을 분석합니다. 이름·정당·선거구·위원회로 검색, 1명이면 자동 상세 반환. analyze=true면 발의법안+표결 종합분석. scope='history'면 역대국회 데이터 조회. mode='party_stats'면 정당별 의석수 현황.",
          "inputSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "name": {
                "description": "의원 이름 (부분 일치 검색)",
                "type": "string"
              },
              "party": {
                "description": "정당명",
                "type": "string"
              },
              "district": {
                "description": "선거구명",
                "type": "string"
              },
              "committee": {
                "description": "소속위원회명 (부분 일치)",
                "type": "string"
              },
              "analyze": {
                "description": "true면 발의법안+표결 종합분석 포함 (기본: false)",
                "type": "boolean"
              },
              "lang": {
                "description": "언어: en이면 영문 API 사용 (검색 모드만 지원)",
                "type": "string",
                "enum": [
                  "en"
                ]
              },
              "age": {
                "description": "대수 (기본: 22 = 제22대 국회)",
                "type": "number"
              },
              "page": {
                "description": "페이지 번호 (기본: 1)",
                "type": "number"
              },
              "page_size": {
                "description": "페이지 크기 (기본: 20, 최대: 100)",
                "type": "number"
              },
              "scope": {
                "description": "current=현재 국회(기본), history=역대국회 데이터 조회",
                "type": "string",
                "enum": [
                  "current",
                  "history"
                ]
              },
              "mode": {
                "description": "party_stats=정당 및 교섭단체 의석수 현황 조회",
                "type": "string",
                "enum": [
                  "party_stats"
                ]
              }
            }
          }
        },
        {
          "name": "assembly_bill",
          "description": "국회 의안을 검색·추적·분석합니다. 의안명/제안자로 검색, bill_id로 상세, keywords로 주제 추적, mode=stats로 통계 조회.",
          "inputSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "bill_name": {
                "description": "의안명 (부분 일치 검색)",
                "type": "string"
              },
              "bill_id": {
                "description": "의안 ID (지정 시 상세 조회 모드)",
                "type": "string"
              },
              "proposer": {
                "description": "제안자/대표발의자 이름",
                "type": "string"
              },
              "committee": {
                "description": "소관위원회명",
                "type": "string"
              },
              "status": {
                "description": "상태 필터: all(전체), pending(계류), processed(처리완료), recent(최근 본회의). 기본: all",
                "type": "string",
                "enum": [
                  "all",
                  "pending",
                  "processed",
                  "recent"
                ]
              },
              "bill_type": {
                "description": "의안 유형: alternative(위원회안/대안)",
                "type": "string",
                "enum": [
                  "alternative"
                ]
              },
              "keywords": {
                "description": "검색 키워드 (쉼표로 구분, 예: \"AI,인공지능\") — 지정 시 track 모드",
                "type": "string"
              },
              "mode": {
                "description": "모드: search(검색), track(추적), stats(통계). 기본: 파라미터로 자동 감지",
                "type": "string",
                "enum": [
                  "search",
                  "track",
                  "stats"
                ]
              },
              "include_history": {
                "description": "심사 이력 포함 여부 (track 모드, 기본: false)",
                "type": "boolean"
              },
              "lang": {
                "description": "언어: en이면 영문 API 사용 (status=recent 검색 모드만 지원)",
                "type": "string",
                "enum": [
                  "en"
                ]
              },
              "age": {
                "description": "대수 (예: 22 = 제22대 국회, 기본: 22)",
                "type": "number"
              },
              "page": {
                "description": "페이지 번호 (기본: 1, search 모드)",
                "type": "number"
              },
              "page_size": {
                "description": "페이지 크기 (기본: 20, 최대: 100)",
                "type": "number"
              }
            }
          }
        },
        {
          "name": "assembly_session",
          "description": "국회 일정·회의록·표결을 조회합니다. type=schedule로 일정, meeting으로 회의록, vote로 표결. 자동 감지 가능.",
          "inputSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "type": {
                "description": "조회 유형. 생략 시 파라미터로 자동 감지",
                "type": "string",
                "enum": [
                  "schedule",
                  "meeting",
                  "vote"
                ]
              },
              "date_from": {
                "description": "시작 날짜 (YYYY-MM-DD) 또는 연도 (YYYY). schedule: 날짜 필터, meeting: 연도 필터",
                "type": "string"
              },
              "date_to": {
                "description": "종료 날짜 (YYYY-MM-DD). schedule 모드에서 범위 검색 시 사용",
                "type": "string"
              },
              "meeting_type": {
                "description": "회의 종류 (meeting 모드)",
                "type": "string",
                "enum": [
                  "본회의",
                  "위원회",
                  "소위원회",
                  "국정감사",
                  "인사청문회",
                  "공청회",
                  "예결위",
                  "특별위",
                  "국정조사",
                  "시정연설",
                  "인사청문",
                  "토론회"
                ]
              },
              "conf_id": {
                "description": "회의록 ID (meeting 모드: 상세 조회)",
                "type": "string"
              },
              "include_explanations": {
                "description": "제안설명서 목록 포함 여부 (meeting 모드, 기본: false)",
                "type": "boolean"
              },
              "keyword": {
                "description": "검색 키워드. schedule: 일정 내용, meeting: 안건명/회의명",
                "type": "string"
              },
              "committee": {
                "description": "위원회명 (schedule/meeting 모드)",
                "type": "string"
              },
              "bill_id": {
                "description": "의안 ID (vote 모드: 의원별 표결 상세)",
                "type": "string"
              },
              "vote_type": {
                "description": "본회의 처리안건 유형 (vote 모드)",
                "type": "string",
                "enum": [
                  "법률안",
                  "예산안",
                  "결산",
                  "기타"
                ]
              },
              "lang": {
                "description": "언어: en이면 영문 API 사용 (schedule 모드만 지원)",
                "type": "string",
                "enum": [
                  "en"
                ]
              },
              "age": {
                "description": "대수 (기본: 22 = 제22대 국회)",
                "type": "number"
              },
              "page": {
                "description": "페이지 번호 (기본: 1)",
                "type": "number"
              },
              "page_size": {
                "description": "페이지 크기 (기본: 20, 최대: 100)",
                "type": "number"
              }
            }
          }
        },
        {
          "name": "assembly_org",
          "description": "위원회·청원·입법예고·보도자료·입법통합(국민참여입법센터)을 조회합니다. type=committee(위원회), petition(청원), legislation_notice(국회 입법예고), press(보도자료), lawmaking(국민참여입법센터). lawmaking category=legislation(입법현황/계획/예고), admin(행정예고), interpretation(법령해석례), opinion(의견제시사례).",
          "inputSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "type": {
                "description": "조회 유형. lawmaking 선택 시 category로 세부 유형 지정",
                "type": "string",
                "enum": [
                  "committee",
                  "petition",
                  "legislation_notice",
                  "press",
                  "lawmaking"
                ]
              },
              "category": {
                "description": "lawmaking 세부 유형. legislation(입법현황/계획/예고), admin(행정예고), interpretation(법령해석례), opinion(의견제시사례)",
                "type": "string",
                "enum": [
                  "legislation",
                  "admin",
                  "interpretation",
                  "opinion"
                ]
              },
              "committee_name": {
                "description": "위원회명 (부분 일치). 지정 시 type=committee 자동 설정",
                "type": "string"
              },
              "include_members": {
                "description": "위원회 위원 명단 포함 여부 (committee_name 지정 시)",
                "type": "boolean"
              },
              "petition_id": {
                "description": "청원 ID (상세 조회). 지정 시 type=petition 자동 설정",
                "type": "string"
              },
              "petition_status": {
                "description": "청원 상태 필터 (기본: pending)",
                "type": "string",
                "enum": [
                  "pending",
                  "processed",
                  "all"
                ]
              },
              "bill_name": {
                "description": "입법예고 법안명 검색 (부분 일치)",
                "type": "string"
              },
              "lang": {
                "description": "언어: en이면 영문 API 사용 (committee/press 모드 지원)",
                "type": "string",
                "enum": [
                  "en"
                ]
              },
              "age": {
                "description": "대수 (예: 22)",
                "type": "number"
              },
              "page": {
                "description": "페이지 번호 (기본: 1)",
                "type": "number"
              },
              "page_size": {
                "description": "페이지 크기 (기본: 20, 최대: 100)",
                "type": "number"
              },
              "keyword": {
                "description": "검색 키워드 (lawmaking 모든 카테고리 공통, UTF-8 인코딩)",
                "type": "string"
              },
              "diff": {
                "description": "예고상태 (lawmaking legislation): 0=진행중, 1=종료",
                "type": "string"
              },
              "ls_cls_cd": {
                "description": "법령분류코드: AA0101(법률), AA0102(대통령령), AA0103~AA0106(시행령/규칙 등)",
                "type": "string"
              },
              "cpt_ofi_org_cd": {
                "description": "소관부처 코드 (예: 1741000=행안부)",
                "type": "string"
              },
              "st_dt_fmt": {
                "description": "시작일자 (YYYY.MM.DD 형식)",
                "type": "string"
              },
              "ed_dt_fmt": {
                "description": "종료일자 (YYYY.MM.DD 형식)",
                "type": "string"
              },
              "lm_pln_yy": {
                "description": "입법계획 연도 (YYYY 형식, lawmaking legislation plan 모드)",
                "type": "string"
              },
              "pmt_cls_cd": {
                "description": "계획구분코드: AB0201(연초), AB0202(추가)",
                "type": "string"
              },
              "search_knd": {
                "description": "검색구분: schLsNm(법령명), schDs(소관부처), schKwrd(키워드)",
                "type": "string"
              },
              "srch_txt": {
                "description": "검색어 (search_knd와 함께 사용)",
                "type": "string"
              },
              "detail_seq": {
                "description": "상세 조회 시 일련번호 (legislation/notice/plan 구분은 mode 파라미터 참고)",
                "type": "string"
              },
              "closing": {
                "description": "마감여부 (lawmaking admin): N=진행, Y=종료",
                "type": "string"
              },
              "prd_fr_day": {
                "description": "검색기간 시작 (YYYY.MM.DD, lawmaking interpretation)",
                "type": "string"
              },
              "prd_to_day": {
                "description": "검색기간 종료 (YYYY.MM.DD, lawmaking interpretation)",
                "type": "string"
              },
              "ls_cpt_org": {
                "description": "소관기관 코드 (lawmaking interpretation)",
                "type": "string"
              },
              "sc_fm_dt": {
                "description": "시작일자 (YYYY.MM.DD, lawmaking opinion)",
                "type": "string"
              },
              "sc_to_dt": {
                "description": "종료일자 (YYYY.MM.DD, lawmaking opinion)",
                "type": "string"
              },
              "sc_text_type": {
                "description": "검색구분 (lawmaking opinion): caseNm(안건명), caseNo(안건번호), reqOrgNm(요청기관)",
                "type": "string",
                "enum": [
                  "caseNm",
                  "caseNo",
                  "reqOrgNm"
                ]
              },
              "sc_text": {
                "description": "검색어 (sc_text_type과 함께 사용)",
                "type": "string"
              }
            }
          }
        },
        {
          "name": "discover_apis",
          "description": "국회 276개 API를 키워드/카테고리로 탐색합니다. 전용 도구가 없는 데이터(청원, 의안통계, 위원회 위원 명단 등)의 API 코드를 찾아 query_assembly로 호출할 수 있습니다.",
          "inputSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "keyword": {
                "description": "검색 키워드 (예: 회의록, 청원, 예산)",
                "type": "string"
              },
              "category": {
                "description": "카테고리 필터 (예: 국회의원, 의정활동별 공개, 보고서)",
                "type": "string"
              },
              "page_size": {
                "description": "결과 수 (기본: 20)",
                "type": "number"
              }
            }
          }
        },
        {
          "name": "query_assembly",
          "description": "API 코드로 국회 데이터를 직접 호출합니다. discover_apis로 찾은 코드를 사용하거나, 알려진 코드를 직접 입력. 전용 도구가 없는 276개 API에 접근하는 범용 도구입니다.",
          "inputSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "api_code": {
                "type": "string",
                "description": "API 코드 (예: ALLSCHEDULE, nwvrqwxyaytdsfvhu, BILLRCP)"
              },
              "params": {
                "description": "API 파라미터 (예: {AGE: 22, BILL_NAME: '교육'})",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              },
              "page": {
                "description": "페이지 번호 (기본: 1)",
                "type": "number"
              },
              "page_size": {
                "description": "페이지 크기 (기본: 20)",
                "type": "number"
              }
            },
            "required": [
              "api_code"
            ]
          }
        },
        {
          "name": "bill_detail",
          "description": "의안 1건의 모든 정보를 한 번에 조회합니다. 상세, 심사, 이력, 제안자, 회의정보를 통합 반환.",
          "inputSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "bill_id": {
                "description": "의안 ID (필수)",
                "type": "string"
              },
              "fields": {
                "description": "조회 항목 (기본: 전체). detail, review, history, proposers, meetings, lifecycle",
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "detail",
                    "review",
                    "history",
                    "proposers",
                    "meetings",
                    "lifecycle"
                  ]
                }
              },
              "age": {
                "description": "대수 (예: 22)",
                "type": "number"
              },
              "page_size": {
                "description": "페이지 크기 (기본: 100, 최대: 100)",
                "type": "number"
              }
            },
            "required": [
              "bill_id"
            ]
          }
        },
        {
          "name": "committee_detail",
          "description": "위원회 상세정보를 조회합니다. 위원회 현황, 위원 명단을 통합 반환.",
          "inputSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "committee_name": {
                "description": "위원회명 (생략 시 전체 목록)",
                "type": "string"
              },
              "include_members": {
                "description": "위원 명단 포함 여부 (committee_name 지정 시 기본: true)",
                "type": "boolean"
              },
              "include_resources": {
                "description": "위원회 부가정보 포함 여부",
                "type": "boolean"
              },
              "age": {
                "description": "대수 (예: 22)",
                "type": "number"
              },
              "page_size": {
                "description": "페이지 크기 (기본: 100, 최대: 100)",
                "type": "number"
              }
            }
          }
        },
        {
          "name": "petition_detail",
          "description": "국민동의청원을 검색하고 상세 조회합니다. 청원ID로 상세, status로 계류/처리 구분.",
          "inputSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "petition_id": {
                "description": "청원 ID (상세 조회 모드)",
                "type": "string"
              },
              "mode": {
                "description": "모드: search(검색/상세, 기본), stats(청원 통계)",
                "type": "string",
                "enum": [
                  "search",
                  "stats"
                ]
              },
              "status": {
                "description": "처리상태 필터 (기본: pending). pending=계류, processed=처리완료, all=전체",
                "type": "string",
                "enum": [
                  "pending",
                  "processed",
                  "all"
                ]
              },
              "keyword": {
