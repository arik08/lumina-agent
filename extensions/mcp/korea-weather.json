{
  "mcpServers": {
    "korea-weather": {
      "type": "stdio",
      "description": "기상청 API 허브 기반 한국 날씨 MCP입니다. 현재 관측, 초단기·단기·중기 예보, 기상특보, 영향예보와 구역코드 검색을 제공합니다.",
      "command": "node",
      "args": [
        "extensions/mcp/korea_weather/dist/index.js",
        "--stdio"
      ],
      "cwd": ".",
      "requiredSecretNames": [
        "KOREA_WEATHER_API_KEY"
      ],
      "timeoutSeconds": 30,
      "tools": [
        {
          "name": "get_nowcast_observation",
          "description": "특정 좌표의 현재 관측 날씨를 조회합니다.",
          "input_schema": {"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"lon":{"type":"number","description":"경도 (longitude)"},"lat":{"type":"number","description":"위도 (latitude)"}},"required":["lon","lat"]}
        },
        {
          "name": "get_nowcast_forecast",
          "description": "특정 좌표의 초단기 예보를 조회합니다.",
          "input_schema": {"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"lon":{"type":"number","description":"경도 (longitude)"},"lat":{"type":"number","description":"위도 (latitude)"}},"required":["lon","lat"]}
        },
        {
          "name": "get_short_term_forecast",
          "description": "특정 좌표의 단기 시간별 예보를 조회합니다.",
          "input_schema": {"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"lon":{"type":"number","description":"경도 (longitude)"},"lat":{"type":"number","description":"위도 (latitude)"}},"required":["lon","lat"]}
        },
        {
          "name": "get_short_term_land_forecast",
          "description": "구역코드 기준 단기 육상예보를 조회합니다.",
          "input_schema": {"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"regId":{"type":"string","description":"단기예보 육상 구역코드 (예: 11B10101)"}},"required":["regId"]}
        },
        {
          "name": "get_short_term_sea_forecast",
          "description": "구역코드 기준 단기 해상예보를 조회합니다.",
          "input_schema": {"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"regId":{"type":"string","description":"단기예보 해상 구역코드 (예: 12A20100)"}},"required":["regId"]}
        },
        {
          "name": "get_weather_situation",
          "description": "발표관서 기준 기상개황을 조회합니다.",
          "input_schema": {"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"stnId":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"발표관서 번호 (예: 108)"}},"required":["stnId"]}
        },
        {
          "name": "get_mid_term_forecast",
          "description": "중기 육상예보를 조회합니다.",
          "input_schema": {"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"regId":{"type":"string","description":"중기 육상 구역코드 (예: 11B00000)"}},"required":["regId"]}
        },
        {
          "name": "get_mid_term_temperature",
          "description": "중기 최저·최고 기온 예보를 조회합니다.",
          "input_schema": {"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"regId":{"type":"string","description":"중기 기온 구역코드 (예: 11B10101)"}},"required":["regId"]}
        },
        {
          "name": "get_active_warnings",
          "description": "현재 발효 중인 기상특보를 조회합니다.",
          "input_schema": {"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"regId":{"description":"특보구역 코드 (선택)","type":"string"}}}
        },
        {
          "name": "get_impact_forecast",
          "description": "폭염·한파 영향예보를 조회합니다.",
          "input_schema": {"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"ifpar":{"type":"string","enum":["hw","cw"],"description":"hw=폭염, cw=한파"},"regId":{"description":"특보구역 코드 (선택, 예: L1050100)","type":"string"}},"required":["ifpar"]}
        },
        {
          "name": "lookup_forecast_zone",
          "description": "단기·중기 예보용 구역코드를 검색합니다.",
          "input_schema": {"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"regId":{"description":"정확한 예보구역 코드 (예: 11B10101)","type":"string"},"regName":{"description":"구역명 한글/영문 부분 검색 (예: \"서울\")","type":"string"}}}
        },
        {
          "name": "lookup_warning_zone",
          "description": "기상특보용 구역코드를 검색합니다.",
          "input_schema": {"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"korName":{"description":"구역명 한글 검색어 (예: \"서울\")","type":"string"}}}
        }
      ]
    }
  }
}
