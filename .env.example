# Lumina runtime
LUMINA_ENVIRONMENT=development
LUMINA_FRONTEND_PORT=5252
LUMINA_BACKEND_PORT=5253
DATABASE_URL=sqlite:///./data/database/lumina.db
LUMINA_COOKIE_SECURE=false

# Run and Tool safety limits (snapshotted into every Run)
LUMINA_SESSION_CONCURRENCY_LIMIT=1
LUMINA_USER_CONCURRENCY_LIMIT=3
LUMINA_SERVER_CONCURRENCY_LIMIT=12
LUMINA_TOOL_CONCURRENCY_LIMIT=4

# Official OpenAI Responses API provider
# Keep this server-side only. Leave OPENAI_BASE_URL unset for the official endpoint.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Codex reuses OPENAI_API_KEY. The hosted image tool model is pinned into each Run.
# LUMINA_CODEX_IMAGE_MODEL=gpt-image-2

# Anthropic Messages API provider
# Keep the key server-side. Override the base URL only for an administrator-approved gateway.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini generateContent provider
# Keep the key server-side. Override the base URL only for an administrator-approved gateway.
GOOGLE_API_KEY=
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Administrator-managed generic OpenAI-compatible provider
# Discovery only suggests remote model IDs. An administrator must register and enable each model.
# LUMINA-prefixed names intentionally avoid changing SDK-wide OpenAI environment variables.
LUMINA_OPENAI_COMPATIBLE_BASE_URL=
LUMINA_OPENAI_COMPATIBLE_API_KEY=

# P-GPT OpenAI-compatible provider
# Copy this file to .env and fill values locally. Never commit .env.
# MyHarness-compatible P-GPT endpoint and non-secret company identifier.
PGPT_BASE_URL=http://pgpt.posco.com/s0la01-gpt/v1
PGPT_API_KEY=
PGPT_EMPLOYEE_NO=
PGPT_COMPANY_CODE=30

# Corporate TLS trust
# Leave blank to use public trust plus automatic fallback discovery at
# ./data/certs/company-ca.crt, C:/POSCO_CA.crt or the Linux Secret mount.
LUMINA_CA_CERT=
LUMINA_CA_BUNDLE=
LUMINA_TLS_COMPAT_MODE=false

# Explicit corporate proxy profile, if required
LUMINA_WEB_PROXY=
HTTPS_PROXY=
NO_PROXY=
