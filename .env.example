# OpenAI 호환 P-GPT 프로바이더
# 값을 로컬에서만 입력하고, 비밀값이 포함된 .env 파일은 절대 커밋하지 마세요.
# MyHarness와 호환되는 P-GPT 엔드포인트 및 비밀값이 아닌 회사 식별자입니다.
PGPT_BASE_URL=http://pgpt.posco.com/s0la01-gpt/v1
PGPT_API_KEY=
PGPT_EMPLOYEE_NO=
PGPT_COMPANY_CODE=30

# 사내 TLS 인증서 신뢰 설정
# 비워 두면 공용 CA를 사용하며, 다음 위치에서 사내 CA 인증서를 자동으로 탐색합니다.
# ./data/certs/company-ca.crt, C:/POSCO_CA.crt 또는 Linux Secret 마운트
LUMINA_CA_CERT=
LUMINA_CA_BUNDLE=
LUMINA_TLS_COMPAT_MODE=false

# Lumina 실행 설정
LUMINA_ENVIRONMENT=development
LUMINA_FRONTEND_PORT=5252
LUMINA_BACKEND_PORT=5253
DATABASE_URL=sqlite:///./data/database/lumina.db
LUMINA_COOKIE_SECURE=false

# Run 및 Tool 안전 한도 (각 Run을 시작할 때 스냅샷으로 고정)
LUMINA_SESSION_CONCURRENCY_LIMIT=1
LUMINA_USER_CONCURRENCY_LIMIT=3
LUMINA_SERVER_CONCURRENCY_LIMIT=12
LUMINA_TOOL_CONCURRENCY_LIMIT=4
# Disable only when background Codex cache warm-up calls are not desired.
LUMINA_CODEX_CACHE_PREWARM_ENABLED=true

# 프로바이더/API 설정값 조회 순서 (아래 API 키와 기본 URL에 적용):
# 1. 이 .env에 있는 비어 있지 않은 값
# 2. .env 값이 없거나 비어 있으면 같은 설정의 프로세스/OS 환경변수
# 3. 둘 다 없으면 Lumina 기본값 (기본값이 정의된 설정만)
# 코드에서 명시적으로 전달한 값은 위 순서보다 우선하며, 변경 후 Lumina를 재시작하세요.

# OpenAI Responses API 공식 프로바이더
# API 키는 서버에서만 보관하세요. 공식 엔드포인트를 사용하려면 OPENAI_BASE_URL을 비워 두세요.
OPENAI_API_KEY=
# 기본 엔드포인트: OPENAI_BASE_URL=https://api.openai.com/v1
# Codex 대화는 로컬 Codex App Server의 ChatGPT OAuth 세션(`codex login`)을 사용합니다.
# OPENAI_API_KEY로 자동 전환하지 않으며, OpenAI API 프로바이더는 별도로 동작합니다.
# Codex 이미지 생성 기능은 OPENAI_API_KEY를 사용하고, 이미지 모델은 각 Run에 고정됩니다.
# 기본 이미지 모델: LUMINA_CODEX_IMAGE_MODEL=gpt-image-2

# Anthropic Messages API 프로바이더
# API 키는 서버에서만 보관하고, 관리자 승인 게이트웨이를 사용할 때만 기본 URL을 변경하세요.
ANTHROPIC_API_KEY=
# 기본 엔드포인트: ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini generateContent 프로바이더
# API 키는 서버에서만 보관하고, 관리자 승인 게이트웨이를 사용할 때만 기본 URL을 변경하세요.
GOOGLE_API_KEY=
# 기본 엔드포인트: GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# 관리자가 구성하는 범용 OpenAI 호환 프로바이더
# 검색 기능은 원격 모델 ID를 후보로만 제안하며, 관리자가 각 모델을 등록하고 활성화해야 합니다.
# LUMINA 접두어는 SDK 전역 OpenAI 환경변수와 충돌하지 않도록 사용합니다.
LUMINA_OPENAI_COMPATIBLE_BASE_URL=
LUMINA_OPENAI_COMPATIBLE_API_KEY=

# 필요한 경우에만 명시적으로 설정하는 사내 프록시
LUMINA_WEB_PROXY=
HTTPS_PROXY=
NO_PROXY=
KOREA_WEATHER_API_KEY=
